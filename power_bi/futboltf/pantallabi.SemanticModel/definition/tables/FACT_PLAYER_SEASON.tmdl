table FACT_PLAYER_SEASON
	lineageTag: e241d426-a720-42a5-9d96-02b87f45308f

	measure Proporcion_Veteranos =
			
			DIVIDE(
			    CALCULATE(
			        DISTINCTCOUNT(FACT_PLAYER_SEASON[PLAYER_KEY]),
			        DIM_AGE_BRACKET[AGE_GROUP] = "32-38"
			    ),
			    DISTINCTCOUNT(FACT_PLAYER_SEASON[PLAYER_KEY]),
			    0
			)
		lineageTag: 435ad164-c6e3-4578-bcbe-638defd1ac74

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Total_Jugadores = DISTINCTCOUNT(FACT_PLAYER_SEASON[PLAYER_KEY])
		formatString: 0
		lineageTag: 9146d507-8ae3-424d-b9c1-bb99259e52b1

	measure Salario_Anual_Promedio = AVERAGE(FACT_PLAYER_SEASON[ANNUAL_WAGE_EUR])
		lineageTag: 2236e027-3a5e-4887-9938-0fb92096e94c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Puntaje_Promedio = AVERAGE(FACT_PLAYER_SEASON[ABILITY_SCORE])
		lineageTag: 559fe8c1-214c-4213-beda-9eff28e66572

		annotation PBI_FormatHint = {"isGeneralNumber":true}

